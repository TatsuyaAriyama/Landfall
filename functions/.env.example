# Public, non-secret deployment parameters.
# Create this Price in Stripe test mode first:
# Product name: 航海証 / Voyage Pass
# Recurring amount: JPY 490 / month
STRIPE_VOYAGE_PASS_PRICE_ID=price_replace_me
PUBLIC_WEB_URL=https://aftide.app

# Never put Stripe keys in this file. Register them in Google Secret Manager:
# firebase functions:secrets:set STRIPE_RESTRICTED_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
