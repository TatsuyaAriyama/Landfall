rules_version = '2';

// KeelMira Firestore セキュリティルール。
//
// 方針:
//  - users/{uid}/** … 本人だけが読み書きできる私的バックアップ。
//  - privateIslands/{code} … 招待コードで参加するホスト島。
//                            配置はホストのみ、位置・チャットは本人のみ書ける。
//  - publicHarbors/{slug} … 公式5港。書けるのも消せるのも書いた本人だけ。
//
// 不変条件(重要):
//  - 誰も他人のドキュメントを書けない。
//  - 島の更新は「自分だけを出し入れする」に限定する。島名・ホスト・他メンバーは
//    改変できない(在港者による乗っ取り・追い出しを防ぐ)。
//  - 一覧(list)は自分が属する港/島だけ。コード総当たりでの列挙を防ぐ。
//  - 文字列・配列は型と長さを検証し、肥大化した書き込みを弾く。
//  - 検証ロジックは下の共有ヘルパーに集約する。同じ規則を二度書かない。
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // 共有ヘルパー
    // ================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 開発者例外はFirebaseが検証したメールクレームに限定。
    // クライアント内の文字列書き換えだけでは突破できない。
    function isDeveloper() {
      return signedIn()
        && request.auth.token.email == 'ari.initx@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ---- 造形トークン ----
    // カードの配色と記号。ここに無い値は書き込めない。

    function styleTokens() {
      return [
        'midnight', 'coral', 'ink', 'seaGreen', 'violet', 'sunYellow',
        'harbor', 'sand', 'ember', 'rust', 'lavender', 'sunrise'
      ];
    }

    // 自分のプロフィール用。港で配る共有カードより1段狭い。
    function profileSymbolTokens() {
      return [
        'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
        'book', 'pen', 'sailboat', 'attire'
      ];
    }

    // 港・島で他人にも見える共有カード用。
    function sharedSymbolTokens() {
      return [
        'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
        'book', 'pen', 'sailboat', 'attire', 'wave', 'comet', 'sun'
      ];
    }

    // ---- 汎用の型チェック ----

    // 航海のはじまり(yyyy-MM-dd)。任意フィールドだが書式は固定し、
    // ここが自由文の置き場にならないようにする。
    function optionalSinceDay(data) {
      return !('sinceDay' in data)
        || (data.sinceDay is string
          && data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // 船の見た目(部位id)。5部位すべてを同じ規則で見る。
    // 任意フィールドなので、書かない旧クライアントの書き込みもそのまま通る。
    function optionalBoatParts(data) {
      return (!('boatSail' in data)
          || (data.boatSail is string && data.boatSail.size() <= 24))
        && (!('boatJib' in data)
          || (data.boatJib is string && data.boatJib.size() <= 24))
        && (!('boatHull' in data)
          || (data.boatHull is string && data.boatHull.size() <= 24))
        && (!('boatStripe' in data)
          || (data.boatStripe is string && data.boatStripe.size() <= 24))
        && (!('boatFlag' in data)
          || (data.boatFlag is string && data.boatFlag.size() <= 24));
    }

    // ---- 共有カード / 共有記録 ----

    function memberCardKeys() {
      return [
        'displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay',
        'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'
      ];
    }

    // 港・島に置く共有カードの共通部分。
    function validMemberCardShape(data) {
      return data.keys().hasOnly(memberCardKeys())
        && data.displayName is string
        && data.displayName.size() <= 60
        && data.styleToken in styleTokens()
        && data.symbolToken in sharedSymbolTokens()
        && data.resolve is string
        && data.resolve.size() <= 80
        && optionalSinceDay(data)
        && optionalBoatParts(data)
        && (!('joinedAt' in data) || data.joinedAt is timestamp);
    }

    // 島の配置バックアップ(自分の島・第2の島・ホスト島スナップショット共通)。
    function validPlacementList(data) {
      return data.placements is list
        && data.placements.size() <= 120;
    }

    // ---- 私的な作業記録 ----

    function validUUID(value) {
      return value is string
        && value.matches(
          '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$'
        );
    }

    function validDayId(value) {
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPrivateRecordDate(value) {
      return value is timestamp
        && value >= timestamp.date(2000, 1, 1)
        && value <= request.time + duration.value(10, 'm');
    }

    // v1.0 の書類には updatedAt が無い。読み直して保存した時点で追加されるため、
    // 欠損だけは互換性のため許し、存在する値は未来へ固定できないよう制限する。
    function validOptionalUpdatedAt(data) {
      return !('updatedAt' in data)
        || (data.updatedAt is timestamp
          && data.updatedAt >= timestamp.date(2000, 1, 1)
          && data.updatedAt <= request.time + duration.value(10, 'm'));
    }

    function validItemStyle(value) {
      return value in styleTokens()
        || value.matches(
          '^pccs-(v|b|s|dp|lt|sf|d|dk|p|ltg|g|dkg)-(0[1-9]|1[0-9]|2[0-4])$'
        )
        || value.matches(
          '^sea-(00[0-9]|0[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9])-(0[0-9]{2}|100)-(0(1[8-9]|[2-9][0-9])|100)$'
        );
    }

    function validItemSymbol(value) {
      return value in [
        'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
        'book', 'pen', 'sailboat', 'attire', 'wave', 'comet', 'sun'
      ];
    }

    function validPrivateItem(data, documentId) {
      return validUUID(documentId)
        && data.keys().hasOnly([
          'name', 'styleToken', 'symbolToken', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'styleToken', 'symbolToken', 'sortOrder', 'createdAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && validItemStyle(data.styleToken)
        && validItemSymbol(data.symbolToken)
        && data.sortOrder is int
        && data.sortOrder >= -1
        && data.sortOrder <= 100000
        && validPrivateRecordDate(data.createdAt)
        && validOptionalUpdatedAt(data);
    }

    function validPrivateSession(data, documentId) {
      return validUUID(documentId)
        && data.keys().hasOnly([
          'date', 'minutes', 'extraSeconds', 'note', 'itemUUID',
          'itemName', 'itemStyle', 'itemSymbol', 'updatedAt'
        ])
        && data.keys().hasAll(['date', 'minutes'])
        && validPrivateRecordDate(data.date)
        && data.minutes is int
        && data.minutes >= 0
        && data.minutes <= 6000
        && (!('extraSeconds' in data)
          || (data.extraSeconds is int
            && data.extraSeconds >= 0
            && data.extraSeconds <= 59))
        && (data.minutes > 0
          || ('extraSeconds' in data && data.extraSeconds > 0))
        && (!('note' in data)
          || (data.note is string && data.note.size() <= 500))
        && (!('itemUUID' in data) || validUUID(data.itemUUID))
        && (!('itemName' in data)
          || (data.itemName is string
            && data.itemName.size() >= 1
            && data.itemName.size() <= 60))
        && (!('itemStyle' in data) || validItemStyle(data.itemStyle))
        && (!('itemSymbol' in data) || validItemSymbol(data.itemSymbol))
        && validOptionalUpdatedAt(data);
    }

    function validPrivateDay(data, documentId) {
      return validDayId(documentId)
        && data.keys().hasOnly(['date', 'note', 'updatedAt'])
        && data.keys().hasAll(['date'])
        && validPrivateRecordDate(data.date)
        && (!('note' in data)
          || (data.note is string && data.note.size() <= 1000))
        && validOptionalUpdatedAt(data);
    }

    function validVoyageLog(data, documentId) {
      return validDayId(documentId)
        && data.keys().hasOnly(['date', 'body', 'updatedAt'])
        && data.keys().hasAll(['date', 'body', 'updatedAt'])
        && validPrivateRecordDate(data.date)
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 260
        && validOptionalUpdatedAt(data);
    }

    function validDestination(data, documentId) {
      return validUUID(documentId)
        && data.keys().hasOnly([
          'name', 'itemUUID', 'targetMinutes', 'targetDate', 'targetHasTime',
          'manual', 'manualDone', 'steps', 'createdAt', 'achievedAt', 'updatedAt'
        ])
        && data.keys().hasAll(['name', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && (!('itemUUID' in data) || validUUID(data.itemUUID))
        && (!('targetMinutes' in data)
          || (data.targetMinutes is int
            && data.targetMinutes >= 1
            && data.targetMinutes <= 600000))
        && (!('targetDate' in data) || data.targetDate is timestamp)
        && (!('targetHasTime' in data) || data.targetHasTime is bool)
        && (!('manual' in data) || data.manual is bool)
        && (!('manualDone' in data) || data.manualDone is bool)
        && validDestinationSteps(data)
        && validPrivateRecordDate(data.createdAt)
        && (!('achievedAt' in data) || data.achievedAt is timestamp)
        && validOptionalUpdatedAt(data);
    }

    function validDestinationStep(step) {
      return step is map
        && step.keys().hasOnly(['id', 'name', 'scheduledAt', 'doneAt'])
        && step.keys().hasAll(['id', 'name'])
        && validUUID(step.id)
        && step.name is string
        && step.name.size() >= 1
        && step.name.size() <= 60
        && (!('scheduledAt' in step) || step.scheduledAt is timestamp)
        && (!('doneAt' in step) || step.doneAt is timestamp);
    }

    // Firestore Rules には配列の全要素ループが無いため、契約上の最大3件を
    // 明示的に検証する。短い配列の範囲外へは短絡評価で触れない。
    function validDestinationSteps(data) {
      return !('steps' in data)
        || (data.steps is list
          && data.steps.size() <= 3
          && (data.steps.size() < 1 || validDestinationStep(data.steps[0]))
          && (data.steps.size() < 2 || validDestinationStep(data.steps[1]))
          && (data.steps.size() < 3 || validDestinationStep(data.steps[2])));
    }

    // ================================================================
    // 私的バックアップ: 本人のみ
    // ================================================================
    // 航海証(entitlements)だけはStripe Webhook / App Store検証の管理SDK専用。
    // 広い users/{uid}/** 許可を残すとクライアントがactive=trueを書けてしまうため、
    // 本人が編集できるドキュメントを明示する。

    match /users/{userId}/gameData/{documentId} {
      function validProfileBackup(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'name', 'styleToken', 'symbolToken',
            'resolve', 'sinceDay', 'updatedAt'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'name', 'styleToken', 'symbolToken',
            'resolve', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && data.name is string
          && data.name.size() <= 12
          && data.styleToken in styleTokens()
          && data.symbolToken in profileSymbolTokens()
          && data.resolve is string
          && data.resolve.size() <= 60
          && optionalSinceDay(data)
          && data.updatedAt == request.time;
      }

      // 自分の島と第2の島(Voyage Pass加入者向け)。検証内容は同一で名前だけが違う。
      // サブスクの有効性はここでは問わない。パスが失効しても既存のバックアップを
      // 消してはならないため、クライアント側が編集画面を開かせないだけで足りる。
      function validHomeIslandBackup(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'placements', 'updatedAt', 'origin'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'placements', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && validPlacementList(data)
          && (!('origin' in data)
            || (data.origin is string && data.origin.size() <= 64))
          && data.updatedAt == request.time;
      }

      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && (
          (documentId == 'profile' && validProfileBackup(request.resource.data))
          || (documentId in ['homeIsland', 'homeIsland2']
            && validHomeIslandBackup(request.resource.data))
        );
      allow delete: if false;
    }

    // 端末間で同期する私的な記録。本人以外は存在も確認できず、本人の書き込みも
    // コレクションごとの契約を満たすものだけ通す。
    match /users/{userId}/items/{documentId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && validPrivateItem(request.resource.data, documentId);
    }

    match /users/{userId}/sessions/{documentId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && validPrivateSession(request.resource.data, documentId);
    }

    match /users/{userId}/days/{documentId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && validPrivateDay(request.resource.data, documentId);
    }

    match /users/{userId}/voyageLogs/{documentId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && validVoyageLog(request.resource.data, documentId);
    }

    match /users/{userId}/destinations/{documentId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && validDestination(request.resource.data, documentId);
    }

    match /users/{userId}/blocks/{targetUserId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && targetUserId.size() >= 1
        && targetUserId.size() <= 128
        && targetUserId != userId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // ================================================================
    // 管理SDK専用
    // ================================================================
    // Stripe顧客ID・Webhook処理履歴・運営キュー・レート制限は、
    // App Check付きCallableが管理SDKで扱う。クライアントからの直接読み書きは
    // 運営データ漏洩・制限迂回になるため常に拒否する。

    match /billingCustomers/{userId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /feedbackRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /publicJournalPublishRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /publicContentReports/{reportId} {
      allow read, write: if false;
    }

    match /publicContentReportLimits/{limitId} {
      allow read, write: if false;
    }

    match /privateIslandChatRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /privateIslandReportLimits/{limitId} {
      allow read, write: if false;
    }

    // 出禁リストは運営だけが書き、ルールからの存在確認だけに使う。
    match /publicHarborBans/{slug}/users/{userId} {
      allow read, write: if false;
    }

    // 招待コードの試行回数。端末に見せると上限の残りが読めてしまう。
    match /privateIslandJoinLimits/{userId} {
      allow read, write: if false;
    }

    // ================================================================
    // プライベート島
    // ================================================================
    // 招待コードを知る人だけが参加でき、ホストの島を同じ場で散策する。
    // 学習記録は持ち込まない。言葉と位置だけを共有する。

    match /privateIslands/{islandId} {
      function islandData() {
        return get(
          /databases/$(database)/documents/privateIslands/$(islandId)
        ).data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in islandData().memberIds;
      }

      // create/join は親の参加登録とメンバーカードを1トランザクションで書く。
      // カードの許可はコミット後の親の状態で判定する。
      function isMemberAfter() {
        return signedIn()
          && request.auth.uid in getAfter(
            /databases/$(database)/documents/privateIslands/$(islandId)
          ).data.memberIds;
      }

      function isHost() {
        return isMember() && islandData().hostUid == request.auth.uid;
      }

      function removesOnlySelf() {
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.hostUid
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      // 島は所属が確定してからしか見えない。招待コードでの参加は
      // `joinPrivateIsland` (App Check + 回数制限付き)が管理SDKで行う。
      // ここで get を全員に開くと、6文字のコードを総当たりして
      // 島名と在島者のUIDを収集できてしまう。
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // 作成数・加入数の上限、航海証、コード衝突、EOS秘密値を同じ
      // トランザクションで確定する `createPrivateIsland` だけが作成する。
      // 端末createでは「1人1島」を競合込みで保証できない。
      allow create: if false;

      // 端末から変更できるのは「自分が抜ける」ことだけ。
      // 加入は管理SDK(joinPrivateIsland)専用にし、端末が自分を island に
      // 書き足せる余地を残さない。
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'hostUid', 'memberIds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.name == resource.data.name
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds is list
        && removesOnlySelf();

      allow delete: if false;

      // EOSの経路情報は親ドキュメントから意図的に分ける。
      // 親は招待コードでのgetを許すが、こちらは参加が確定した後だけ見える。
      // 秘密値は独立した256bitのbase64url。
      match /runtime/{runtimeId} {
        function validEOSRuntimePayload(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.keys().hasAll([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.schemaVersion == 1
            && data.sessionLocator is string
            && data.sessionLocator.matches('^[A-Za-z0-9_-]{43}$')
            && data.socketSecret is string
            && data.socketSecret.matches('^[A-Za-z0-9_-]{43}$')
            && data.createdAt is timestamp;
        }

        function isHostAfter() {
          return signedIn()
            && request.auth.uid == getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.hostUid
            && request.auth.uid in getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.memberIds;
        }

        allow read: if runtimeId == 'eos' && isMember();
        allow create: if runtimeId == 'eos'
          && isHostAfter()
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // ホストは公開前の壊れたデータを直せるが、島を開き直しても
        // 有効な秘密値を回して在島メンバーを分断することはできない。
        allow update: if runtimeId == 'eos'
          && isHostAfter()
          && !validEOSRuntimePayload(resource.data)
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }

      match /members/{memberId} {
        // 島のカードは名前・船・参加時刻まで必須。港より一段厳しい。
        function validIslandMemberCard(data) {
          return validMemberCardShape(data)
            && data.keys().hasAll([
              'displayName', 'styleToken', 'symbolToken', 'resolve',
              'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag',
              'joinedAt'
            ])
            && data.displayName.size() >= 1
            && data.joinedAt is timestamp;
        }

        allow read: if isMember();
        allow create: if isMemberAfter()
          && request.auth.uid == memberId
          && validIslandMemberCard(request.resource.data)
          && request.resource.data.joinedAt == request.time;
        allow update: if isMemberAfter()
          && request.auth.uid == memberId
          && validIslandMemberCard(request.resource.data)
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if isMember() && request.auth.uid == memberId;
      }

      // ホストの端末で編集した配置の読み取り専用スナップショット。
      match /island/{snapshotId} {
        function validSnapshot(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'revision', 'placements', 'updatedAt'
            ])
            && data.schemaVersion == 1
            && data.revision is int
            && validPlacementList(data)
            && data.updatedAt == request.time;
        }

        allow read: if isMember();
        allow create: if snapshotId == 'current'
          && isHost()
          && validSnapshot(request.resource.data)
          && request.resource.data.revision == 1;
        allow update: if snapshotId == 'current'
          && isHost()
          && validSnapshot(request.resource.data)
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      // 各クライアントは自分の位置だけ書き、島のメンバーだけが読む。
      match /presence/{memberId} {
        function validPresence(data) {
          return data.keys().hasOnly([
              'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase',
              'seatPlacementId', 'seatSlotId', 'arrivalNonce', 'updatedAt'
            ])
            && data.keys().hasAll([
              'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase', 'updatedAt'
            ])
            && data.uid == request.auth.uid
            && data.x is number && data.x >= -80 && data.x <= 80
            && data.z is number && data.z >= -80 && data.z <= 80
            && data.yaw is number && data.yaw >= -7 && data.yaw <= 7
            && data.pose in [
              'idle', 'walk', 'lookout', 'raise', 'hail', 'point',
              'stargaze', 'rest', 'sit', 'lie'
            ]
            // 'voyage' は同行の航海。島を離れて同じ船に乗っている状態を
            // 表すだけで、座標は島にいたときのものをそのまま持つ。
            && data.scene in [
              'island',
              'interior:weathered_cottage',
              'interior:navigator_tent',
              'voyage'
            ]
            && data.phase in [
              'arrival', 'explore', 'edit', 'camera', 'departure',
              'muster', 'sailing'
            ]
            // 席は「配置id + スロットid」を必ず対で書く。片方だけは受け付けない。
            && (('seatPlacementId' in data) == ('seatSlotId' in data))
            && (!('seatPlacementId' in data)
              || (data.seatPlacementId is string
                && data.seatPlacementId.matches(
                  '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                )))
            && (!('seatSlotId' in data)
              || (data.seatSlotId is string
                && data.seatSlotId.size() >= 1
                && data.seatSlotId.size() <= 40))
            && (!('arrivalNonce' in data)
              || (data.arrivalNonce is string
                && data.arrivalNonce.size() >= 1
                && data.arrivalNonce.size() <= 40))
            && data.updatedAt == request.time;
        }

        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == memberId
          && validPresence(request.resource.data);
        allow delete: if isMember() && request.auth.uid == memberId;
      }

      // 島内チャット。学習記録の自動投稿は廃止し、言葉だけを扱う。
      match /chat/{messageId} {
        allow read: if isMember();
        // 作成はApp Check・所属・本文・速度制限を確認するCallableだけが行う。
        // 端末からの直接createを残すと、改造クライアントが連投制限を迂回できる。
        allow create: if false;
        allow update: if false;
        allow delete: if isMember() && request.auth.uid == resource.data.uid;
      }
    }

    // ================================================================
    // パブリックの港(公式5港)
    // ================================================================
    // 参加すると、名前・アイコン・作業記録がその港に表示される。
    // 不変条件: 書けるのも消せるのも「書いた本人だけ」。読みはサインイン済みなら誰でも。

    match /publicHarbors/{slug} {
      function canWriteAs(memberId) {
        return isSelf(memberId)
          && slug in ['language', 'certification', 'student', 'reading', 'making']
          && !exists(
            /databases/$(database)/documents/publicHarborBans/$(slug)/users/$(memberId)
          );
      }

      match /members/{memberId} {
        allow get: if signedIn();
        allow list: if signedIn()
          && request.query.limit != null
          && request.query.limit <= 200;
        allow create: if canWriteAs(memberId)
          && validMemberCardShape(request.resource.data)
          && request.resource.data.joinedAt == request.time;
        allow update: if canWriteAs(memberId)
          && validMemberCardShape(request.resource.data)
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if isSelf(memberId);

        // 月ID・全セッション・総byte数・参加状態・時間上限を検証する
        // `publishPublicHarborMonth` だけが作成・更新する。
        match /months/{monthId} {
          allow read: if signedIn();
          allow create, update: if false;
          allow delete: if isSelf(memberId);
        }
      }
    }

    // ================================================================
    // 公開誌(一日一頁)
    // ================================================================
    // 作成・更新・削除はApp Check付きCallableだけがAdmin SDKで行う。
    // 日付、1日1件、所属港、画像サイズをクライアントの直接書込みに委ねない。

    match /publicJournalEntries/{entryId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 30;
      allow create, update, delete: if false;
    }

    // ================================================================
    // 通報(Callable経由。読めるのは運営=コンソールのみ)
    // ================================================================
    // 通報できるのは「自分が居る島で、実在する他人の発言」だけ。
    // 本文もサーバー側の実データと一致していなければ受け付けない。

    match /reports/{reportId} {
      // 実データ照合・重複排除・一日上限を行うCallableだけが作成する。
      allow read, create, update, delete: if false;
    }
  }
}
