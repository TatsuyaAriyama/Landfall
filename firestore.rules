rules_version = '2';

// Landfall Firestore セキュリティルール。
//
// 方針:
//  - users/{uid}/** … 本人だけが読み書きできる私的バックアップ。
//  - rooms/{code}   … 招待コード(=ドキュメントID)を知る者が入れる友人向けの港。
//                      コードそのものが合鍵。中身は港名とメンバー一覧のみ。
//  - members/…      … 同じ港のメンバー同士だけが互いのカード・記録を読める。
//                      書き込めるのは本人だけ。
//
// 不変条件(重要):
//  - 誰も他人のドキュメントを書けない。
//  - 港の更新は「自分だけを出し入れする」に限定する。港名・作成者・他メンバーは
//    改変できない(在港者による乗っ取り・追い出しを防ぐ)。
//  - 一覧(list)は自分が属する港/共有だけ。コード総当たりでの列挙を防ぐ。
//  - 文字列・配列は型と長さを検証し、肥大化した書き込みを弾く。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 私的バックアップ: 本人のみ + コレクションごとのスキーマ検証 ----
    // 認証だけの再帰ワイルドカードは、本人なら巨大文字列・未知フィールド・不正型も
    // 保存できてしまう。読み取り権限は本人に保ちつつ、書き込みは既知の契約だけを通す。
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validUUID(value) {
        return value is string
          && value.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$');
      }

      function validDayID(value) {
        return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function validItemStyle(value) {
        return value is string
          && (
            value in ['midnight', 'coral', 'ink', 'seaGreen', 'violet', 'sunYellow']
            || value.matches('^sea-([0-2][0-9][0-9]|3[0-5][0-9])-(0[0-9][0-9]|100)-(0(1[8-9]|[2-9][0-9])|100)$')
            || value.matches('^pccs-(v|b|s|dp|lt|sf|d|dk|p|ltg|g|dkg)-(0[1-9]|1[0-9]|2[0-4])$')
          );
      }

      function validItem() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'styleToken', 'symbolToken', 'sortOrder', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['name', 'styleToken', 'symbolToken', 'sortOrder', 'createdAt', 'updatedAt'])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
          && validItemStyle(data.styleToken)
          && data.symbolToken in ['anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix', 'book', 'pen', 'sailboat', 'attire', 'headphones', 'cupcake']
          && data.sortOrder is int
          && data.sortOrder >= -100000 && data.sortOrder <= 100000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function validSession() {
        let data = request.resource.data;
        return data.keys().hasAll(['date', 'minutes', 'updatedAt'])
          && data.keys().hasOnly(['date', 'minutes', 'note', 'itemUUID', 'itemName', 'itemStyle', 'itemSymbol', 'updatedAt'])
          && data.date is timestamp
          && data.minutes is int && data.minutes >= 0 && data.minutes <= 6000
          && (!('note' in data) || (data.note is string && data.note.size() <= 120))
          && (!('itemUUID' in data) || validUUID(data.itemUUID))
          && (!('itemName' in data) || (data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 60))
          && (!('itemStyle' in data) || (data.itemStyle is string && data.itemStyle.size() <= 24))
          && (!('itemSymbol' in data) || (data.itemSymbol is string && data.itemSymbol.size() <= 24))
          && data.updatedAt is timestamp;
      }

      function validDay() {
        let data = request.resource.data;
        return data.keys().hasAll(['date', 'updatedAt'])
          && data.keys().hasOnly(['date', 'note', 'updatedAt'])
          && data.date is timestamp
          && (!('note' in data) || (data.note is string && data.note.size() <= 120))
          && data.updatedAt is timestamp;
      }

      function validVoyageLog() {
        let data = request.resource.data;
        return data.keys().hasAll(['date', 'body', 'updatedAt'])
          && data.keys().hasOnly(['date', 'body', 'updatedAt'])
          && data.date is timestamp
          && data.body is string && data.body.size() >= 1 && data.body.size() <= 260
          && data.updatedAt is timestamp;
      }

      function validDestinationStep(step) {
        return step is map
          && step.keys().hasAll(['id', 'name'])
          && step.keys().hasOnly(['id', 'name', 'scheduledAt', 'doneAt'])
          && validUUID(step.id)
          && step.name is string && step.name.size() >= 1 && step.name.size() <= 60
          && (!('scheduledAt' in step) || step.scheduledAt is timestamp)
          && (!('doneAt' in step) || step.doneAt is timestamp);
      }

      // Firestore Rules には list の汎用ループがないため、上限20件を個別に検証する。
      // 件数だけでなく各要素の型・キー・文字数も固定し、steps 内へ巨大な自由データを
      // 入れられないようにする。
      function validDestinationSteps(steps) {
        return steps is list && steps.size() >= 1 && steps.size() <= 20
          && (steps.size() < 1 || validDestinationStep(steps[0]))
          && (steps.size() < 2 || validDestinationStep(steps[1]))
          && (steps.size() < 3 || validDestinationStep(steps[2]))
          && (steps.size() < 4 || validDestinationStep(steps[3]))
          && (steps.size() < 5 || validDestinationStep(steps[4]))
          && (steps.size() < 6 || validDestinationStep(steps[5]))
          && (steps.size() < 7 || validDestinationStep(steps[6]))
          && (steps.size() < 8 || validDestinationStep(steps[7]))
          && (steps.size() < 9 || validDestinationStep(steps[8]))
          && (steps.size() < 10 || validDestinationStep(steps[9]))
          && (steps.size() < 11 || validDestinationStep(steps[10]))
          && (steps.size() < 12 || validDestinationStep(steps[11]))
          && (steps.size() < 13 || validDestinationStep(steps[12]))
          && (steps.size() < 14 || validDestinationStep(steps[13]))
          && (steps.size() < 15 || validDestinationStep(steps[14]))
          && (steps.size() < 16 || validDestinationStep(steps[15]))
          && (steps.size() < 17 || validDestinationStep(steps[16]))
          && (steps.size() < 18 || validDestinationStep(steps[17]))
          && (steps.size() < 19 || validDestinationStep(steps[18]))
          && (steps.size() < 20 || validDestinationStep(steps[19]));
      }

      function validDestination() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly([
            'name', 'itemUUID', 'targetMinutes', 'targetDate', 'targetHasTime',
            'manual', 'manualDone', 'steps', 'createdAt', 'achievedAt', 'updatedAt'
          ])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
          && (!('itemUUID' in data) || validUUID(data.itemUUID))
          && (!('targetMinutes' in data) || (data.targetMinutes is int && data.targetMinutes >= 1 && data.targetMinutes <= 600000))
          && (!('targetDate' in data) || data.targetDate is timestamp)
          && (!('targetHasTime' in data) || data.targetHasTime is bool)
          && (!('manual' in data) || data.manual is bool)
          && (!('manualDone' in data) || data.manualDone is bool)
          && (!('steps' in data) || validDestinationSteps(data.steps))
          && data.createdAt is timestamp
          && (!('achievedAt' in data) || data.achievedAt is timestamp)
          && data.updatedAt is timestamp;
      }

      match /items/{itemId} {
        allow read: if isOwner();
        allow create, update: if isOwner() && validUUID(itemId) && validItem();
        allow delete: if isOwner();
      }

      match /sessions/{sessionId} {
        allow read: if isOwner();
        allow create, update: if isOwner() && validUUID(sessionId) && validSession();
        allow delete: if isOwner();
      }

      match /days/{dayId} {
        allow read: if isOwner();
        allow create, update: if isOwner() && validDayID(dayId) && validDay();
        allow delete: if isOwner();
      }

      match /voyageLogs/{dayId} {
        allow read: if isOwner();
        allow create, update: if isOwner() && validDayID(dayId) && validVoyageLog();
        allow delete: if isOwner();
      }

      match /destinations/{destinationId} {
        allow read: if isOwner();
        allow create, update: if isOwner() && validUUID(destinationId) && validDestination();
        allow delete: if isOwner();
      }

      match /blocks/{blockedUserId} {
        allow read: if isOwner();
        allow create, update: if isOwner()
          && blockedUserId.size() >= 1 && blockedUserId.size() <= 128
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is timestamp;
        allow delete: if isOwner();
      }

      // Stripe Webhook（管理SDK）だけが書き込み、本人は状態の読み取りだけできる。
      match /entitlements/{entitlementId} {
        allow read: if isOwner();
        allow write: if false;
      }

      // 新しい個人コレクションは、ルールとスキーマを同時に追加するまで閉じる。
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Stripeの顧客対応表とWebhook処理履歴は管理SDK専用。
    match /billingCustomers/{userId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ---- 港(ルーム) ----
    match /rooms/{roomId} {

      // get: コードを知っていれば単票は読める(参加のための存在確認・サインイン必須)。
      // list: 自分が属する港だけ。コード総当たりでの列挙・メンバーUID収集を防ぐ。
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // 作成: 自分だけをメンバーに入れて作る。ownerUid は作成者本人(以後不変・権限は無い)。
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdAt', 'ownerUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is timestamp;

      // 更新: 「自分だけを加える」または「自分だけを外す」に限定。
      // 港名・作成日時・他メンバーは一切改変できず、余計なフィールドも足せない
      // (共有ドキュメントへの肥大データ注入を防ぐ)。
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdAt', 'ownerUid'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && ( !('ownerUid' in resource.data)
          || request.resource.data.ownerUid == resource.data.ownerUid )
        && request.resource.data.memberIds is list
        && ( addsOnlySelf() || removesOnlySelf() );

      // 港ドキュメント自体の削除は不可。
      allow delete: if false;

      // 自分だけを1人加えた(他メンバーは全員そのまま)。人数上限で多重防御。
      function addsOnlySelf() {
        return !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 4;   // プライベートの港は4人まで
      }

      // 自分だけを1人外した(他メンバーは誰も追加・削除していない)。
      function removesOnlySelf() {
        return request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }

      // ---- 港にいる間だけの航海士プレゼンス ----
      // 位置・向き・装備・現在の仕草だけを共有する一時データ。履歴は持たず、
      // 書けるのは本人のドキュメントだけ。クライアントは古い updatedAt を描画しない。
      match /presence/{memberId} {
        allow read: if isMember();

        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && isMember()
          && request.resource.data.keys().hasAll([
            'x', 'z', 'yaw', 'pose', 'aboard', 'sailX',
            'fishingRod', 'emoteSeq', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'x', 'z', 'yaw', 'pose', 'aboard', 'sailX',
            'fishingRod', 'emoteSeq', 'updatedAt'
          ])
          && request.resource.data.x is number
          && request.resource.data.x >= -6.5
          && request.resource.data.x <= 6.5
          && request.resource.data.z is number
          && request.resource.data.z >= -8.5
          && request.resource.data.z <= 2.8
          && request.resource.data.yaw is number
          && request.resource.data.yaw >= -3.142
          && request.resource.data.yaw <= 3.142
          && request.resource.data.pose in [
            'idle', 'walk', 'pickupRod', 'equipRod', 'holdRod', 'walkRod',
            'stowRod', 'hail', 'raise', 'point', 'lookout', 'rest'
          ]
          && request.resource.data.aboard is bool
          && request.resource.data.sailX is number
          && request.resource.data.sailX >= -0.75
          && request.resource.data.sailX <= 0.75
          && request.resource.data.fishingRod is bool
          && request.resource.data.emoteSeq is int
          && request.resource.data.emoteSeq >= 0
          && request.resource.data.emoteSeq <= 2147483647
          && request.resource.data.updatedAt == request.time;

        // 港を閉じる／退港する際は、自分の残像だけ消せる。
        allow delete: if request.auth != null && request.auth.uid == memberId;
      }

      // ---- メンバーのプレイヤーカード ----
      match /members/{memberId} {
        // 読めるのは同じ港のメンバーだけ。
        allow read: if isMember();

        // 書けるのは、その港のメンバー本人だけ。フィールドは既知のものに限り、型と長さを検証する
        // (未参加の港へのドキュメント設置や、余計なフィールド・肥大データの注入を防ぐ)。
        // boat* は船の見た目(部位id)、sinceDay は航海のはじまり。いずれも任意フィールド=
        // hasOnly のサブセット規則により、これらを書かない旧クライアント(iOS)の
        // 従来5フィールド書き込みもそのまま通る。
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && isMember()
          && request.resource.data.keys().hasOnly(['displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay', 'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.styleToken is string
          && request.resource.data.styleToken.size() <= 24
          && request.resource.data.symbolToken is string
          && request.resource.data.symbolToken.size() <= 24
          && request.resource.data.resolve is string
          && request.resource.data.resolve.size() <= 80
          && request.resource.data.joinedAt is timestamp
          && ( !('boatSail' in request.resource.data)
            || (request.resource.data.boatSail is string && request.resource.data.boatSail.size() <= 24) )
          && ( !('boatJib' in request.resource.data)
            || (request.resource.data.boatJib is string && request.resource.data.boatJib.size() <= 24) )
          && ( !('boatHull' in request.resource.data)
            || (request.resource.data.boatHull is string && request.resource.data.boatHull.size() <= 24) )
          && ( !('boatStripe' in request.resource.data)
            || (request.resource.data.boatStripe is string && request.resource.data.boatStripe.size() <= 24) )
          && ( !('boatFlag' in request.resource.data)
            || (request.resource.data.boatFlag is string && request.resource.data.boatFlag.size() <= 24) )
          // 航海のはじまり(yyyy-MM-dd)。任意フィールド。書式を固定して、
          // ここが自由文の置き場にならないようにする。
          && ( !('sinceDay' in request.resource.data)
            || (request.resource.data.sinceDay is string
              && request.resource.data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) );

        // 退港時に自分のカードを消す。
        allow delete: if request.auth != null && request.auth.uid == memberId;

        // ---- 月ごとの共有記録 ----
        match /months/{monthId} {
          allow read: if isMember();

          allow create, update: if request.auth != null
            && request.auth.uid == memberId
            && isMember()
            && request.resource.data.keys().hasOnly(['days', 'sessions', 'updatedAt'])
            && request.resource.data.days is list
            && request.resource.data.days.size() <= 31
            && request.resource.data.sessions is list
            && request.resource.data.sessions.size() <= 1000
            && request.resource.data.updatedAt is timestamp
            && monthId.matches('^[0-9]{4}-[0-9]{2}$');

          allow delete: if request.auth != null && request.auth.uid == memberId;
        }
      }

      // ---- 共同航海(単一ドキュメント voyage/current) ----
      // 目的地を決めると seed から海図(3航路)がひらき、選んだ航路を全員で進む。
      // 航路の中身(海域の位置)は seed からクライアントが決定的に導出するので
      // ここには置かない。進捗もカウンタを持たず、各メンバーの months から
      // 閲覧者が導出する。到着(arrivedAt)は在港者の誰かが1回だけ書ける。
      // 4人の友人港なので、作成・削除は在港者なら誰でも(簡素に)。
      match /voyage/{voyageId} {
        allow read: if isMember();

        // 作成: 在港者が、最小のキー集合で。seed・目標時間(分)・航路番号を検証する。
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['seed', 'targetMinutes', 'routeIndex', 'createdAt', 'createdBy'])
          && request.resource.data.seed is int
          && request.resource.data.seed >= 0
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes >= 60
          && request.resource.data.targetMinutes <= 600000
          && request.resource.data.routeIndex is int
          && request.resource.data.routeIndex >= 0
          && request.resource.data.routeIndex <= 2
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;

        // 更新: arrivedAt を一度だけ足せる(到着の刻印)。他フィールドは不変。
        allow update: if isMember()
          && !('arrivedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrivedAt'])
          && request.resource.data.arrivedAt is timestamp;

        // 削除: 在港者なら誰でも(到着後に「次の航海」で仕舞うため)。
        allow delete: if isMember();
      }

      // ---- 旧「港の試練」(quest/current) ----
      // 共同航海に置き換え済み。デプロイ済みの旧クライアントが読めるよう
      // しばらく残置する(新規の書き込みはもう発生しない)。
      match /quest/{questId} {
        allow read: if isMember();

        // 作成: 在港者が、最小のキー集合で。kind と目標時間(分)を検証する。
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['kind', 'targetMinutes', 'createdAt', 'createdBy'])
          && request.resource.data.kind in ['kraken', 'storm']
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes >= 60
          && request.resource.data.targetMinutes <= 600000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;

        // 更新: defeatedAt を一度だけ足せる(討伐の刻印)。他フィールドは不変。
        allow update: if isMember()
          && !('defeatedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defeatedAt'])
          && request.resource.data.defeatedAt is timestamp;

        // 削除: 在港者なら誰でも(討伐後に「新たな試練」で流すため)。
        allow delete: if isMember();
      }

      // ---- チャット(言葉 + 着岸/帰還の自動の行) ----
      match /chat/{messageId} {
        allow read: if isMember();

        // 発言・自動の行とも、在港者本人だけが自分の uid で書ける。
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['text', 'landfall', 'return']
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() == 0
          && request.resource.data.createdAt is timestamp
          && (
            ( request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'createdAt', 'reactions'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 500 )
            ||
            ( request.resource.data.kind in ['landfall', 'return']
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'itemName', 'itemStyle', 'itemSymbol', 'minutes', 'gapDays', 'createdAt', 'reactions'])
              && request.resource.data.itemName is string
              && request.resource.data.itemName.size() <= 60
              && request.resource.data.itemStyle is string
              && request.resource.data.itemStyle.size() <= 24
              && request.resource.data.itemSymbol is string
              && request.resource.data.itemSymbol.size() <= 24
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 0
              && request.resource.data.minutes <= 6000
              && request.resource.data.gapDays is int
              && request.resource.data.gapDays >= 0 )
          );

        // リアクション機能は廃止。チャット本文を含め、送信後の更新は許可しない。
        allow update: if false;

        // 自分の発言だけ、書いてから1時間以内に限り取り下げられる。
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.uid
          && request.time < resource.data.createdAt + duration.value(1, 'h');
      }
    }

    // ---- パブリックの港(公式5港) ----
    // 参加すると、名前・アイコン・作業記録がその港に表示される。
    // 不変条件: 書けるのも消せるのも「書いた本人だけ」。読みはサインイン済みなら誰でも。
    match /publicHarbors/{slug} {
      function validSlug() {
        return slug in ['language', 'certification', 'student', 'reading', 'making'];
      }

      // メンバーのプレイヤーカード。
      match /members/{memberId} {
        allow read: if request.auth != null;

        // boat* は船の見た目(部位id)。任意フィールドなので旧クライアントの書き込みも通る。
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && validSlug()
          && request.resource.data.keys().hasOnly(['displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay', 'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.styleToken is string
          && request.resource.data.styleToken.size() <= 24
          && request.resource.data.symbolToken is string
          && request.resource.data.symbolToken.size() <= 24
          && request.resource.data.resolve is string
          && request.resource.data.resolve.size() <= 80
          && request.resource.data.joinedAt is timestamp
          && ( !('boatSail' in request.resource.data)
            || (request.resource.data.boatSail is string && request.resource.data.boatSail.size() <= 24) )
          && ( !('boatJib' in request.resource.data)
            || (request.resource.data.boatJib is string && request.resource.data.boatJib.size() <= 24) )
          && ( !('boatHull' in request.resource.data)
            || (request.resource.data.boatHull is string && request.resource.data.boatHull.size() <= 24) )
          && ( !('boatStripe' in request.resource.data)
            || (request.resource.data.boatStripe is string && request.resource.data.boatStripe.size() <= 24) )
          && ( !('boatFlag' in request.resource.data)
            || (request.resource.data.boatFlag is string && request.resource.data.boatFlag.size() <= 24) )
          // 航海のはじまり(yyyy-MM-dd)。任意フィールド。書式を固定して、
          // ここが自由文の置き場にならないようにする。
          && ( !('sinceDay' in request.resource.data)
            || (request.resource.data.sinceDay is string
              && request.resource.data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) );

        // 退港・削除は本人のみ。
        allow delete: if request.auth != null && request.auth.uid == memberId;

        // 月ごとの共有記録。積み上がって残り、消せるのは本人だけ。
        match /months/{monthId} {
          allow read: if request.auth != null;

          allow create, update: if request.auth != null
            && request.auth.uid == memberId
            && validSlug()
            && request.resource.data.keys().hasOnly(['days', 'sessions', 'updatedAt'])
            && request.resource.data.days is list
            && request.resource.data.days.size() <= 31
            && request.resource.data.sessions is list
            && request.resource.data.sessions.size() <= 1000
            && request.resource.data.updatedAt is timestamp
            && monthId.matches('^[0-9]{4}-[0-9]{2}$');

          allow delete: if request.auth != null && request.auth.uid == memberId;
        }
      }
    }

    // ---- 通報(書き捨て。読めるのは運営=コンソールのみ) ----
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterUid', 'roomId', 'targetUid', 'messageId', 'text', 'createdAt'])
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() >= 1
        && request.resource.data.roomId.size() <= 128
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() >= 1
        && request.resource.data.targetUid.size() <= 128
        && (!('messageId' in request.resource.data)
          || (request.resource.data.messageId is string && request.resource.data.messageId.size() <= 128))
        && (!('text' in request.resource.data)
          || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
