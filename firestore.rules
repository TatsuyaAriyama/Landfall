rules_version = '2';

// KeelMira Firestore セキュリティルール。
//
// 方針:
//  - users/{uid}/** … 本人だけが読み書きできる私的バックアップ。
//  - privateIslands/{code} … 招待コードで参加するホスト島。
//                            配置はホストのみ、位置・チャットは本人のみ書ける。
//  - publicHarbors/{slug} … 公式5港。書けるのも消せるのも書いた本人だけ。
//
// 不変条件(重要):
//  - 誰も他人のドキュメントを書けない。
//  - 島の更新は「自分だけを出し入れする」に限定する。島名・ホスト・他メンバーは
//    改変できない(在港者による乗っ取り・追い出しを防ぐ)。
//  - 一覧(list)は自分が属する港/島だけ。コード総当たりでの列挙を防ぐ。
//  - 文字列・配列は型と長さを検証し、肥大化した書き込みを弾く。
//  - 検証ロジックは下の共有ヘルパーに集約する。同じ規則を二度書かない。
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // 共有ヘルパー
    // ================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 開発者例外はFirebaseが検証したメールクレームに限定。
    // クライアント内の文字列書き換えだけでは突破できない。
    function isDeveloper() {
      return signedIn()
        && request.auth.token.email == 'ari.initx@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function entitlementIsActive(userId, entitlementId) {
      let entitlement = /databases/$(database)/documents/users/$(userId)/entitlements/$(entitlementId);
      return exists(entitlement)
        && get(entitlement).data.active == true
        && get(entitlement).data.currentPeriodEnd is timestamp
        && get(entitlement).data.currentPeriodEnd > request.time;
    }

    function hasVoyagePass() {
      return isDeveloper()
        || (
          signedIn()
          && (
            entitlementIsActive(request.auth.uid, 'voyagePass')
            || entitlementIsActive(request.auth.uid, 'voyagePassAppStore')
          )
        );
    }

    // ---- 造形トークン ----
    // カードの配色と記号。ここに無い値は書き込めない。

    function styleTokens() {
      return [
        'midnight', 'coral', 'ink', 'seaGreen', 'violet', 'sunYellow',
        'harbor', 'sand', 'ember', 'rust', 'lavender', 'sunrise'
      ];
    }

    // 自分のプロフィール用。港で配る共有カードより1段狭い。
    function profileSymbolTokens() {
      return [
        'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
        'book', 'pen', 'sailboat', 'attire'
      ];
    }

    // 港・島で他人にも見える共有カード用。
    function sharedSymbolTokens() {
      return [
        'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
        'book', 'pen', 'sailboat', 'attire', 'wave', 'comet', 'sun'
      ];
    }

    // ---- 汎用の型チェック ----

    // 航海のはじまり(yyyy-MM-dd)。任意フィールドだが書式は固定し、
    // ここが自由文の置き場にならないようにする。
    function optionalSinceDay(data) {
      return !('sinceDay' in data)
        || (data.sinceDay is string
          && data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // 船の見た目(部位id)。5部位すべてを同じ規則で見る。
    // 任意フィールドなので、書かない旧クライアントの書き込みもそのまま通る。
    function optionalBoatParts(data) {
      return (!('boatSail' in data)
          || (data.boatSail is string && data.boatSail.size() <= 24))
        && (!('boatJib' in data)
          || (data.boatJib is string && data.boatJib.size() <= 24))
        && (!('boatHull' in data)
          || (data.boatHull is string && data.boatHull.size() <= 24))
        && (!('boatStripe' in data)
          || (data.boatStripe is string && data.boatStripe.size() <= 24))
        && (!('boatFlag' in data)
          || (data.boatFlag is string && data.boatFlag.size() <= 24));
    }

    // ---- 共有カード / 共有記録 ----

    function memberCardKeys() {
      return [
        'displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay',
        'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'
      ];
    }

    // 港・島に置く共有カードの共通部分。
    function validMemberCardShape(data) {
      return data.keys().hasOnly(memberCardKeys())
        && data.displayName is string
        && data.displayName.size() <= 60
        && data.styleToken in styleTokens()
        && data.symbolToken in sharedSymbolTokens()
        && data.resolve is string
        && data.resolve.size() <= 80
        && optionalSinceDay(data)
        && optionalBoatParts(data);
    }

    // 月ごとの共有記録。日と作業セッションの束。
    function validMonthPayload(data) {
      return data.keys().hasOnly(['days', 'sessions', 'updatedAt'])
        && data.days is list
        && data.days.size() <= 31
        && data.sessions is list
        && data.sessions.size() <= 1000;
    }

    // 島の配置バックアップ(自分の島・第2の島・ホスト島スナップショット共通)。
    function validPlacementList(data) {
      return data.placements is list
        && data.placements.size() <= 120;
    }

    // ================================================================
    // 私的バックアップ: 本人のみ
    // ================================================================
    // 航海証(entitlements)だけはStripe Webhook / App Store検証の管理SDK専用。
    // 広い users/{uid}/** 許可を残すとクライアントがactive=trueを書けてしまうため、
    // 本人が編集できるドキュメントを明示する。

    match /users/{userId}/gameData/{documentId} {
      function validProfileBackup(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'name', 'styleToken', 'symbolToken',
            'resolve', 'sinceDay', 'updatedAt'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'name', 'styleToken', 'symbolToken',
            'resolve', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && data.name is string
          && data.name.size() <= 12
          && data.styleToken in styleTokens()
          && data.symbolToken in profileSymbolTokens()
          && data.resolve is string
          && data.resolve.size() <= 60
          && optionalSinceDay(data)
          && data.updatedAt == request.time;
      }

      // 自分の島と第2の島(Voyage Pass加入者向け)。検証内容は同一で名前だけが違う。
      // サブスクの有効性はここでは問わない。パスが失効しても既存のバックアップを
      // 消してはならないため、クライアント側が編集画面を開かせないだけで足りる。
      function validHomeIslandBackup(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'placements', 'updatedAt', 'origin'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'placements', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && validPlacementList(data)
          && (!('origin' in data)
            || (data.origin is string && data.origin.size() <= 64))
          && data.updatedAt == request.time;
      }

      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && (
          (documentId == 'profile' && validProfileBackup(request.resource.data))
          || (documentId in ['homeIsland', 'homeIsland2']
            && validHomeIslandBackup(request.resource.data))
        );
      allow delete: if false;
    }

    // 端末間で同期する私的な記録。本人以外は存在も確認できない。
    // 形はクライアントのDTOに委ねるが、フィールド数の上限だけは置いて、
    // 自分の領域を無制限に膨らませる書き込みを防ぐ(DTOは最大11フィールド)。
    match /users/{userId}/{collectionId}/{documentId} {
      allow read, delete: if isSelf(userId)
        && collectionId in [
          'items', 'sessions', 'days', 'voyageLogs', 'destinations', 'blocks'
        ];
      allow create, update: if isSelf(userId)
        && collectionId in [
          'items', 'sessions', 'days', 'voyageLogs', 'destinations', 'blocks'
        ]
        && request.resource.data.keys().size() <= 32;
    }

    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // ================================================================
    // 管理SDK専用
    // ================================================================
    // Stripe顧客ID・Webhook処理履歴・運営キュー・レート制限は、
    // App Check付きCallableが管理SDKで扱う。クライアントからの直接読み書きは
    // 運営データ漏洩・制限迂回になるため常に拒否する。

    match /billingCustomers/{userId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /feedbackRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /publicJournalPublishRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /publicContentReports/{reportId} {
      allow read, write: if false;
    }

    match /publicContentReportLimits/{limitId} {
      allow read, write: if false;
    }

    // 出禁リストは運営だけが書き、ルールからの存在確認だけに使う。
    match /publicHarborBans/{slug}/users/{userId} {
      allow read, write: if false;
    }

    // 招待コードの試行回数。端末に見せると上限の残りが読めてしまう。
    match /privateIslandJoinLimits/{userId} {
      allow read, write: if false;
    }

    // ================================================================
    // プライベート島
    // ================================================================
    // 招待コードを知る人だけが参加でき、ホストの島を同じ場で散策する。
    // 学習記録は持ち込まない。言葉と位置だけを共有する。

    match /privateIslands/{islandId} {
      function islandData() {
        return get(
          /databases/$(database)/documents/privateIslands/$(islandId)
        ).data;
      }

      function isMember() {
        return signedIn() && request.auth.uid in islandData().memberIds;
      }

      // create/join は親の参加登録とメンバーカードを1トランザクションで書く。
      // カードの許可はコミット後の親の状態で判定する。
      function isMemberAfter() {
        return signedIn()
          && request.auth.uid in getAfter(
            /databases/$(database)/documents/privateIslands/$(islandId)
          ).data.memberIds;
      }

      function isHost() {
        return isMember() && islandData().hostUid == request.auth.uid;
      }

      function removesOnlySelf() {
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.hostUid
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      // 島は所属が確定してからしか見えない。招待コードでの参加は
      // `joinPrivateIsland` (App Check + 回数制限付き)が管理SDKで行う。
      // ここで get を全員に開くと、6文字のコードを総当たりして
      // 島名と在島者のUIDを収集できてしまう。
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && hasVoyagePass()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'hostUid', 'memberIds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // 端末から変更できるのは「自分が抜ける」ことだけ。
      // 加入は管理SDK(joinPrivateIsland)専用にし、端末が自分を island に
      // 書き足せる余地を残さない。
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'hostUid', 'memberIds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.name == resource.data.name
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds is list
        && removesOnlySelf();

      allow delete: if false;

      // EOSの経路情報は親ドキュメントから意図的に分ける。
      // 親は招待コードでのgetを許すが、こちらは参加が確定した後だけ見える。
      // 秘密値は独立した256bitのbase64url。
      match /runtime/{runtimeId} {
        function validEOSRuntimePayload(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.keys().hasAll([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.schemaVersion == 1
            && data.sessionLocator is string
            && data.sessionLocator.matches('^[A-Za-z0-9_-]{43}$')
            && data.socketSecret is string
            && data.socketSecret.matches('^[A-Za-z0-9_-]{43}$')
            && data.createdAt is timestamp;
        }

        function isHostAfter() {
          return signedIn()
            && request.auth.uid == getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.hostUid
            && request.auth.uid in getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.memberIds;
        }

        allow read: if runtimeId == 'eos' && isMember();
        allow create: if runtimeId == 'eos'
          && isHostAfter()
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // ホストは公開前の壊れたデータを直せるが、島を開き直しても
        // 有効な秘密値を回して在島メンバーを分断することはできない。
        allow update: if runtimeId == 'eos'
          && isHostAfter()
          && !validEOSRuntimePayload(resource.data)
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }

      match /members/{memberId} {
        // 島のカードは名前・船・参加時刻まで必須。港より一段厳しい。
        function validIslandMemberCard(data) {
          return validMemberCardShape(data)
            && data.keys().hasAll([
              'displayName', 'styleToken', 'symbolToken', 'resolve',
              'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag',
              'joinedAt'
            ])
            && data.displayName.size() >= 1
            && data.joinedAt is timestamp;
        }

        allow read: if isMember();
        allow create: if isMemberAfter()
          && request.auth.uid == memberId
          && validIslandMemberCard(request.resource.data)
          && request.resource.data.joinedAt == request.time;
        allow update: if isMemberAfter()
          && request.auth.uid == memberId
          && validIslandMemberCard(request.resource.data)
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if isMember() && request.auth.uid == memberId;
      }

      // ホストの端末で編集した配置の読み取り専用スナップショット。
      match /island/{snapshotId} {
        function validSnapshot(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'revision', 'placements', 'updatedAt'
            ])
            && data.schemaVersion == 1
            && data.revision is int
            && validPlacementList(data)
            && data.updatedAt == request.time;
        }

        allow read: if isMember();
        allow create: if snapshotId == 'current'
          && isHost()
          && validSnapshot(request.resource.data)
          && request.resource.data.revision == 1;
        allow update: if snapshotId == 'current'
          && isHost()
          && validSnapshot(request.resource.data)
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      // 各クライアントは自分の位置だけ書き、島のメンバーだけが読む。
      match /presence/{memberId} {
        function validPresence(data) {
          return data.keys().hasOnly([
              'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase',
              'seatPlacementId', 'seatSlotId', 'arrivalNonce', 'updatedAt'
            ])
            && data.keys().hasAll([
              'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase', 'updatedAt'
            ])
            && data.uid == request.auth.uid
            && data.x is number && data.x >= -80 && data.x <= 80
            && data.z is number && data.z >= -80 && data.z <= 80
            && data.yaw is number && data.yaw >= -7 && data.yaw <= 7
            && data.pose in [
              'idle', 'walk', 'lookout', 'raise', 'hail', 'point',
              'stargaze', 'rest', 'sit', 'lie'
            ]
            && data.scene in [
              'island',
              'interior:weathered_cottage',
              'interior:navigator_tent'
            ]
            && data.phase in [
              'arrival', 'explore', 'edit', 'camera', 'departure'
            ]
            // 席は「配置id + スロットid」を必ず対で書く。片方だけは受け付けない。
            && (('seatPlacementId' in data) == ('seatSlotId' in data))
            && (!('seatPlacementId' in data)
              || (data.seatPlacementId is string
                && data.seatPlacementId.matches(
                  '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
                )))
            && (!('seatSlotId' in data)
              || (data.seatSlotId is string
                && data.seatSlotId.size() >= 1
                && data.seatSlotId.size() <= 40))
            && (!('arrivalNonce' in data)
              || (data.arrivalNonce is string
                && data.arrivalNonce.size() >= 1
                && data.arrivalNonce.size() <= 40))
            && data.updatedAt == request.time;
        }

        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == memberId
          && validPresence(request.resource.data);
        allow delete: if isMember() && request.auth.uid == memberId;
      }

      // 島内チャット。学習記録の自動投稿は廃止し、言葉だけを扱う。
      match /chat/{messageId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly([
            'uid', 'senderName', 'kind', 'text', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.senderName == get(
            /databases/$(database)/documents/privateIslands/$(islandId)/members/$(request.auth.uid)
          ).data.displayName
          && request.resource.data.kind == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && !request.resource.data.text.matches(
            '(?i).*(kill[ ._-]*yourself|\\bkys\\b|nigger|faggot|死ね|しね|殺す|ころす|自殺しろ).*'
          )
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isMember() && request.auth.uid == resource.data.uid;
      }
    }

    // ================================================================
    // パブリックの港(公式5港)
    // ================================================================
    // 参加すると、名前・アイコン・作業記録がその港に表示される。
    // 不変条件: 書けるのも消せるのも「書いた本人だけ」。読みはサインイン済みなら誰でも。

    match /publicHarbors/{slug} {
      function canWriteAs(memberId) {
        return isSelf(memberId)
          && slug in ['language', 'certification', 'student', 'reading', 'making']
          && !exists(
            /databases/$(database)/documents/publicHarborBans/$(slug)/users/$(memberId)
          );
      }

      match /members/{memberId} {
        allow read: if signedIn();
        allow create, update: if canWriteAs(memberId)
          && validMemberCardShape(request.resource.data);
        allow delete: if isSelf(memberId);

        // 月ごとの共有記録。積み上がって残り、消せるのは本人だけ。
        match /months/{monthId} {
          allow read: if signedIn();
          allow create, update: if canWriteAs(memberId)
            && validMonthPayload(request.resource.data);
          allow delete: if isSelf(memberId);
        }
      }
    }

    // ================================================================
    // 公開誌(一日一頁)
    // ================================================================
    // 作成・更新・削除はApp Check付きCallableだけがAdmin SDKで行う。
    // 日付、1日1件、所属港、画像サイズをクライアントの直接書込みに委ねない。

    match /publicJournalEntries/{entryId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && request.query.limit != null
        && request.query.limit <= 30;
      allow create, update, delete: if false;
    }

    // ================================================================
    // 通報(書き捨て。読めるのは運営=コンソールのみ)
    // ================================================================
    // 通報できるのは「自分が居る島で、実在する他人の発言」だけ。
    // 本文もサーバー側の実データと一致していなければ受け付けない。

    match /reports/{reportId} {
      // 形と本人性だけを見る。実データ照合の前に、安いチェックで弾く。
      function validReportShape(data) {
        return data.keys().hasOnly([
            'source', 'privateIslandCode', 'reporterUid', 'targetUid',
            'messageId', 'text', 'createdAt'
          ])
          && data.source == 'privateIsland'
          && data.reporterUid == request.auth.uid
          && data.privateIslandCode is string
          && data.privateIslandCode.matches('^[A-HJ-NP-Z2-9]{6}$')
          && data.targetUid is string
          && data.targetUid.size() >= 1
          && data.targetUid.size() <= 128
          && data.targetUid != request.auth.uid
          && data.messageId is string
          && data.messageId.size() >= 1
          && data.messageId.size() <= 128
          && data.text is string
          && data.text.size() <= 500
          && data.createdAt == request.time;
      }

      // 通報できるのは「自分が居る島の、実在する他人の発言」だけ。
      // 本文もサーバー側の実データと一致していなければ受け付けない。
      function matchesStoredChat(data) {
        let island = /databases/$(database)/documents/privateIslands/$(data.privateIslandCode);
        let message = /databases/$(database)/documents/privateIslands/$(data.privateIslandCode)/chat/$(data.messageId);
        return exists(island)
          && request.auth.uid in get(island).data.memberIds
          && data.targetUid in get(island).data.memberIds
          && exists(message)
          && get(message).data.uid == data.targetUid
          && get(message).data.text == data.text;
      }

      allow create: if signedIn()
        && validReportShape(request.resource.data)
        && matchesStoredChat(request.resource.data);
      allow read, update, delete: if false;
    }
  }
}
