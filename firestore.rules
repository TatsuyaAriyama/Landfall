rules_version = '2';

// KeelMira Firestore セキュリティルール。
//
// 方針:
//  - users/{uid}/** … 本人だけが読み書きできる私的バックアップ。
//  - privateIslands/{code} … 招待コードで参加するホスト島。
//                            配置はホストのみ、位置・チャットは本人のみ書ける。
//  - members/…            … 同じ島のメンバー同士だけがカードを読める。
//                            学習記録はプライベート島では共有しない。
//
// 不変条件(重要):
//  - 誰も他人のドキュメントを書けない。
//  - 島の更新は「自分だけを出し入れする」に限定する。島名・ホスト・他メンバーは
//    改変できない(在港者による乗っ取り・追い出しを防ぐ)。
//  - 一覧(list)は自分が属する港/共有だけ。コード総当たりでの列挙を防ぐ。
//  - 文字列・配列は型と長さを検証し、肥大化した書き込みを弾く。
service cloud.firestore {
  match /databases/{database}/documents {

    // 開発者例外はFirebaseが検証したメールクレームに限定。
    // クライアント内の文字列書き換えだけでは突破できない。
    function isDeveloper() {
      return request.auth != null
        && request.auth.token.email == 'ari.initx@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function entitlementIsActive(userId, entitlementId) {
      let entitlement = /databases/$(database)/documents/users/$(userId)/entitlements/$(entitlementId);
      return exists(entitlement)
        && get(entitlement).data.active == true
        && get(entitlement).data.currentPeriodEnd is timestamp
        && get(entitlement).data.currentPeriodEnd > request.time;
    }

    function hasVoyagePass() {
      return isDeveloper()
        || (
          request.auth != null
          && (
            entitlementIsActive(request.auth.uid, 'voyagePass')
            || entitlementIsActive(request.auth.uid, 'voyagePassAppStore')
          )
        );
    }

    // ---- 私的バックアップ: 本人のみ ----
    // 航海証(entitlements)だけはStripe Webhook / App Store検証の管理SDK専用。
    // 広い users/{uid}/** 許可を残すと、クライアントがactive=trueを書けてしまうため、
    // 本人が編集できる既存コレクションを明示する。
    match /users/{userId}/{collectionId}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionId in ['items', 'sessions', 'days', 'voyageLogs', 'destinations', 'blocks'];
    }

    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Stripe顧客IDとWebhook処理履歴は管理SDKだけが使用する。
    match /billingCustomers/{userId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // 改善案と連投制限はApp Check付きCallableが管理SDKで書く。
    // クライアントからの直接読み書きは運営データ漏洩・制限迂回になるため常に拒否する。
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /feedbackRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /publicJournalPublishRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // ---- プライベート島(v2) ----
    // 招待コードを知る人だけが参加でき、ホストの島を同じ場で散策する。
    // 以前の学習記録共有・共同タイマーは持ち込まない。
    match /privateIslands/{islandId} {
      function privateIslandData() {
        return get(
          /databases/$(database)/documents/privateIslands/$(islandId)
        ).data;
      }

      function isPrivateIslandMember() {
        return request.auth != null
          && request.auth.uid in privateIslandData().memberIds;
      }

      // create/join commits the parent membership and member card in one
      // transaction. Authorize the card against the post-commit parent state.
      function isPrivateIslandMemberAfter() {
        return request.auth != null
          && request.auth.uid in getAfter(
            /databases/$(database)/documents/privateIslands/$(islandId)
          ).data.memberIds;
      }

      function isPrivateIslandHost() {
        return isPrivateIslandMember()
          && privateIslandData().hostUid == request.auth.uid;
      }

      function addsOnlyPrivateIslandSelf() {
        return !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 8;
      }

      function removesOnlyPrivateIslandSelf() {
        return request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.hostUid
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      // get は招待コードで参加するために必要。list は自分の島に限る。
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && hasVoyagePass()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'hostUid', 'memberIds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // 共有ドキュメントで変更できるのは自分の入退島だけ。
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'name', 'hostUid', 'memberIds', 'createdAt'
        ])
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.name == resource.data.name
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds is list
        && (
          addsOnlyPrivateIslandSelf()
          || removesOnlyPrivateIslandSelf()
        );

      allow delete: if false;

      // EOS routing material is deliberately separated from the parent room.
      // The parent permits authenticated get-by-invite-code for the legacy
      // join transaction, while this document is visible only after membership
      // has been committed. Secrets are independent 256-bit base64url values.
      match /runtime/{runtimeId} {
        function validEOSRuntimePayload(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.keys().hasAll([
              'schemaVersion', 'sessionLocator', 'socketSecret', 'createdAt'
            ])
            && data.schemaVersion == 1
            && data.sessionLocator is string
            && data.sessionLocator.matches('^[A-Za-z0-9_-]{43}$')
            && data.socketSecret is string
            && data.socketSecret.matches('^[A-Za-z0-9_-]{43}$')
            && data.createdAt is timestamp;
        }

        function isRuntimeHostAfter() {
          return request.auth != null
            && request.auth.uid == getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.hostUid
            && request.auth.uid in getAfter(
              /databases/$(database)/documents/privateIslands/$(islandId)
            ).data.memberIds;
        }

        allow read: if runtimeId == 'eos' && isPrivateIslandMember();
        allow create: if runtimeId == 'eos'
          && isRuntimeHostAfter()
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // A host can repair malformed pre-release data, but reopening an island
        // can never rotate an already valid secret and split active members.
        allow update: if runtimeId == 'eos'
          && isRuntimeHostAfter()
          && !validEOSRuntimePayload(resource.data)
          && validEOSRuntimePayload(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }

      match /members/{memberId} {
        function validPrivateIslandMemberPayload() {
          return request.resource.data.keys().hasOnly([
              'displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay',
              'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag',
              'joinedAt'
            ])
            && request.resource.data.keys().hasAll([
              'displayName', 'styleToken', 'symbolToken', 'resolve',
              'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag',
              'joinedAt'
            ])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 60
            && request.resource.data.styleToken is string
            && request.resource.data.styleToken.size() <= 24
            && request.resource.data.styleToken in [
              'midnight', 'coral', 'ink', 'seaGreen', 'violet', 'sunYellow',
              'harbor', 'sand', 'ember', 'rust', 'lavender', 'sunrise'
            ]
            && request.resource.data.symbolToken is string
            && request.resource.data.symbolToken.size() <= 24
            && request.resource.data.symbolToken in [
              'anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix',
              'book', 'pen', 'sailboat', 'attire', 'wave', 'comet', 'sun'
            ]
            && request.resource.data.resolve is string
            && request.resource.data.resolve.size() <= 80
            && (!('sinceDay' in request.resource.data)
              || (request.resource.data.sinceDay is string
                && request.resource.data.sinceDay.size() == 10))
            && request.resource.data.boatSail is string
            && request.resource.data.boatSail.size() <= 24
            && request.resource.data.boatJib is string
            && request.resource.data.boatJib.size() <= 24
            && request.resource.data.boatHull is string
            && request.resource.data.boatHull.size() <= 24
            && request.resource.data.boatStripe is string
            && request.resource.data.boatStripe.size() <= 24
            && request.resource.data.boatFlag is string
            && request.resource.data.boatFlag.size() <= 24
            && request.resource.data.joinedAt is timestamp;
        }

        allow read: if isPrivateIslandMember();
        allow create: if isPrivateIslandMemberAfter()
          && request.auth.uid == memberId
          && validPrivateIslandMemberPayload()
          && request.resource.data.joinedAt == request.time;
        allow update: if isPrivateIslandMemberAfter()
          && request.auth.uid == memberId
          && validPrivateIslandMemberPayload()
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if isPrivateIslandMember()
          && request.auth.uid == memberId;
      }

      // 主の端末で編集した配置の読み取り専用スナップショット。
      match /island/{snapshotId} {
        function validPrivateIslandSnapshotPayload() {
          return request.resource.data.keys().hasOnly([
              'schemaVersion', 'revision', 'placements', 'updatedAt'
            ])
            && request.resource.data.schemaVersion == 1
            && request.resource.data.revision is int
            && request.resource.data.placements is list
            && request.resource.data.placements.size() <= 120
            && request.resource.data.updatedAt == request.time;
        }

        allow read: if isPrivateIslandMember();
        allow create: if snapshotId == 'current'
          && isPrivateIslandHost()
          && validPrivateIslandSnapshotPayload()
          && request.resource.data.revision == 1;
        allow update: if snapshotId == 'current'
          && isPrivateIslandHost()
          && validPrivateIslandSnapshotPayload()
          && resource.data.revision is int
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      // 各クライアントは自分の位置だけ書き、島のメンバーだけが読む。
      match /presence/{memberId} {
        allow read: if isPrivateIslandMember();
        allow create, update: if isPrivateIslandMember()
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly([
            'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase',
            'seatPlacementId', 'seatSlotId', 'arrivalNonce', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid', 'x', 'z', 'yaw', 'pose', 'scene', 'phase', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.x is number
          && request.resource.data.x >= -80
          && request.resource.data.x <= 80
          && request.resource.data.z is number
          && request.resource.data.z >= -80
          && request.resource.data.z <= 80
          && request.resource.data.yaw is number
          && request.resource.data.yaw >= -7
          && request.resource.data.yaw <= 7
          && request.resource.data.pose in [
            'idle', 'walk', 'lookout', 'raise', 'hail', 'point',
            'stargaze', 'rest', 'sit', 'lie'
          ]
          && request.resource.data.scene in [
            'island',
            'interior:weathered_cottage',
            'interior:navigator_tent'
          ]
          && request.resource.data.phase in [
            'arrival', 'explore', 'edit', 'camera', 'departure'
          ]
          && (('seatPlacementId' in request.resource.data)
            == ('seatSlotId' in request.resource.data))
          && (!('seatPlacementId' in request.resource.data)
            || (request.resource.data.seatPlacementId is string
              && request.resource.data.seatPlacementId.size() == 36
              && request.resource.data.seatPlacementId.matches(
                '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
              )))
          && (!('seatSlotId' in request.resource.data)
            || (request.resource.data.seatSlotId is string
              && request.resource.data.seatSlotId.size() >= 1
              && request.resource.data.seatSlotId.size() <= 40))
          && (!('arrivalNonce' in request.resource.data)
            || (request.resource.data.arrivalNonce is string
              && request.resource.data.arrivalNonce.size() >= 1
              && request.resource.data.arrivalNonce.size() <= 40))
          && request.resource.data.updatedAt == request.time;
        allow delete: if isPrivateIslandMember()
          && request.auth.uid == memberId;
      }

      // 島内チャット。学習記録の自動投稿は廃止し、言葉だけを扱う。
      match /chat/{messageId} {
        allow read: if isPrivateIslandMember();
        allow create: if isPrivateIslandMember()
          && request.resource.data.keys().hasOnly([
            'uid', 'senderName', 'kind', 'text', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.senderName == get(
            /databases/$(database)/documents/privateIslands/$(islandId)/members/$(request.auth.uid)
          ).data.displayName
          && request.resource.data.kind == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && !request.resource.data.text.matches(
            '(?i).*(kill[ ._-]*yourself|\\bkys\\b|nigger|faggot|死ね|しね|殺す|ころす|自殺しろ).*'
          )
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isPrivateIslandMember()
          && request.auth.uid == resource.data.uid;
      }
    }

    // ---- 旧プライベート港(v1、管理SDKの移行削除専用) ----
    // 旧クライアントからの rooms への再書き込みを止めるため、
    // 従来ルールは到達不可能な legacyRooms 名で保存する。
    match /legacyRooms/{roomId} {

      // get: コードを知っていれば単票は読める(参加のための存在確認・サインイン必須)。
      // list: 自分が属する港だけ。コード総当たりでの列挙・メンバーUID収集を防ぐ。
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // 作成: 航海証(または確認済み開発者)だけ。参加には航海証を求めない。
      allow create: if request.auth != null
        && hasVoyagePass()
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdAt', 'ownerUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // 更新: 「自分だけを加える」または「自分だけを外す」に限定。
      // 港名・作成日時・他メンバーは一切改変できず、余計なフィールドも足せない
      // (共有ドキュメントへの肥大データ注入を防ぐ)。
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdAt', 'ownerUid'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          ( 'ownerUid' in resource.data
            && request.resource.data.ownerUid == resource.data.ownerUid )
          ||
          ( !('ownerUid' in resource.data)
            && !('ownerUid' in request.resource.data) )
        )
        && request.resource.data.memberIds is list
        && ( addsOnlySelf() || removesOnlySelf() );

      // 港ドキュメント自体の削除は不可。
      allow delete: if false;

      // 自分だけを1人加えた(他メンバーは全員そのまま)。人数上限で多重防御。
      function addsOnlySelf() {
        return !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 4;   // プライベートの港は4人まで
      }

      // 自分だけを1人外した(他メンバーは誰も追加・削除していない)。
      function removesOnlySelf() {
        return request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }

      function isOwner() {
        let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
        return isMember()
          && (
            ( 'ownerUid' in room
              && room.ownerUid in room.memberIds
              && room.ownerUid == request.auth.uid )
            ||
            ( ( !('ownerUid' in room) || !(room.ownerUid in room.memberIds) )
              && room.memberIds.size() > 0
              && room.memberIds[0] == request.auth.uid )
          );
      }

      function hasCrewPlan(sessionId, memberId) {
        return exists(
          /databases/$(database)/documents/rooms/$(roomId)/crewSessions/$(sessionId)/plans/$(memberId)
        );
      }

      function allCrewReady(sessionId) {
        let memberIds = get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.memberIds;
        return memberIds.size() > 0
          && hasCrewPlan(sessionId, memberIds[0])
          && (memberIds.size() < 2 || hasCrewPlan(sessionId, memberIds[1]))
          && (memberIds.size() < 3 || hasCrewPlan(sessionId, memberIds[2]))
          && (memberIds.size() < 4 || hasCrewPlan(sessionId, memberIds[3]));
      }

      function crewSessionData(sessionId) {
        return get(
          /databases/$(database)/documents/rooms/$(roomId)/crewSessions/$(sessionId)
        ).data;
      }

      function crewSessionHasNotStarted(sessionId) {
        return !('startedAt' in crewSessionData(sessionId));
      }

      function crewSessionHasFinished(sessionId) {
        let session = crewSessionData(sessionId);
        return session.startedAt is timestamp
          && session.durationMinutes is int
          && request.time >= session.startedAt
            + duration.value(session.durationMinutes, 'm');
      }

      // ---- メンバーのプレイヤーカード ----
      match /members/{memberId} {
        // 読めるのは同じ港のメンバーだけ。
        allow read: if isMember();

        // 書けるのは、その港のメンバー本人だけ。フィールドは既知のものに限り、型と長さを検証する
        // (未参加の港へのドキュメント設置や、余計なフィールド・肥大データの注入を防ぐ)。
        // boat* は船の見た目(部位id)、sinceDay は航海のはじまり。いずれも任意フィールド=
        // hasOnly のサブセット規則により、これらを書かない旧クライアント(iOS)の
        // 従来5フィールド書き込みもそのまま通る。
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && isMember()
          && request.resource.data.keys().hasOnly(['displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay', 'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.styleToken is string
          && request.resource.data.styleToken.size() <= 24
          && request.resource.data.symbolToken is string
          && request.resource.data.symbolToken.size() <= 24
          && request.resource.data.resolve is string
          && request.resource.data.resolve.size() <= 80
          && ( !('boatSail' in request.resource.data)
            || (request.resource.data.boatSail is string && request.resource.data.boatSail.size() <= 24) )
          && ( !('boatJib' in request.resource.data)
            || (request.resource.data.boatJib is string && request.resource.data.boatJib.size() <= 24) )
          && ( !('boatHull' in request.resource.data)
            || (request.resource.data.boatHull is string && request.resource.data.boatHull.size() <= 24) )
          && ( !('boatStripe' in request.resource.data)
            || (request.resource.data.boatStripe is string && request.resource.data.boatStripe.size() <= 24) )
          && ( !('boatFlag' in request.resource.data)
            || (request.resource.data.boatFlag is string && request.resource.data.boatFlag.size() <= 24) )
          // 航海のはじまり(yyyy-MM-dd)。任意フィールド。書式を固定して、
          // ここが自由文の置き場にならないようにする。
          && ( !('sinceDay' in request.resource.data)
            || (request.resource.data.sinceDay is string
              && request.resource.data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) );

        // 退港時に自分のカードを消す。
        allow delete: if request.auth != null && request.auth.uid == memberId;

        // ---- 月ごとの共有記録 ----
        match /months/{monthId} {
          allow read: if isMember();

          allow create, update: if request.auth != null
            && request.auth.uid == memberId
            && isMember()
            && request.resource.data.keys().hasOnly(['days', 'sessions', 'updatedAt'])
            && request.resource.data.days is list
            && request.resource.data.days.size() <= 31
            && request.resource.data.sessions is list
            && request.resource.data.sessions.size() <= 1000;

          allow delete: if request.auth != null && request.auth.uid == memberId;
        }
      }

      // ---- 最大4人の共通タイマー ----
      // 船長が時間を決め、全員が自分の作業項目と意図を準備してから一斉に出航する。
      // Web/iOS共通: crewSessionsの最新1件を購読し、plans/{uid}は本人だけが書く。
      match /crewSessions/{sessionId} {
        allow read: if isMember();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly([
            'durationMinutes', 'createdAt', 'createdBy'
          ])
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 1
          && request.resource.data.durationMinutes <= 240
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid;

        // 船長だけが、出航前の時間変更またはstartedAtの一度きりの追加を行える。
        allow update: if isOwner()
          && request.resource.data.keys().hasOnly([
            'durationMinutes', 'createdAt', 'createdBy', 'startedAt'
          ])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 1
          && request.resource.data.durationMinutes <= 240
          && (
            ( !('startedAt' in resource.data)
              && !('startedAt' in request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['durationMinutes']) )
            ||
            ( !('startedAt' in resource.data)
              && request.resource.data.startedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['startedAt'])
              && allCrewReady(sessionId) )
          );

        // 履歴は消さない。次の航海は新しいcrewSessionsドキュメントを作る。
        allow delete: if false;

        match /plans/{memberId} {
          allow read: if isMember();

          // 準備は出航前だけ。本人のplanだけを作成でき、サーバー時刻を使う。
          allow create: if isMember()
            && request.auth.uid == memberId
            && crewSessionHasNotStarted(sessionId)
            && request.resource.data.keys().hasOnly([
              'itemId', 'itemName', 'itemStyle', 'itemSymbol',
              'intention', 'preparedAt', 'recall', 'recordedAt'
            ])
            && request.resource.data.itemId is string
            && request.resource.data.itemId.size() <= 80
            && request.resource.data.itemName is string
            && request.resource.data.itemName.size() <= 60
            && request.resource.data.itemStyle is string
            && request.resource.data.itemStyle.size() <= 24
            && request.resource.data.itemSymbol is string
            && request.resource.data.itemSymbol.size() <= 24
            && request.resource.data.intention is string
            && request.resource.data.intention.size() >= 1
            && request.resource.data.intention.size() <= 80
            && request.resource.data.preparedAt == request.time
            && !('recall' in request.resource.data)
            && !('recordedAt' in request.resource.data);

          // 出航前は準備内容だけを編集可能。到着後は元の準備を変えず、
          // recall/recordedAtを一度だけ追加できる。早送り・履歴改ざんを防ぐ。
          allow update: if isMember()
            && request.auth.uid == memberId
            && request.resource.data.keys().hasOnly([
              'itemId', 'itemName', 'itemStyle', 'itemSymbol',
              'intention', 'preparedAt', 'recall', 'recordedAt'
            ])
            && request.resource.data.itemId is string
            && request.resource.data.itemId.size() <= 80
            && request.resource.data.itemName is string
            && request.resource.data.itemName.size() <= 60
            && request.resource.data.itemStyle is string
            && request.resource.data.itemStyle.size() <= 24
            && request.resource.data.itemSymbol is string
            && request.resource.data.itemSymbol.size() <= 24
            && request.resource.data.intention is string
            && request.resource.data.intention.size() >= 1
            && request.resource.data.intention.size() <= 80
            && (
              ( crewSessionHasNotStarted(sessionId)
                && request.resource.data.preparedAt == request.time
                && !('recall' in request.resource.data)
                && !('recordedAt' in request.resource.data) )
              ||
              ( crewSessionHasFinished(sessionId)
                && !('recall' in resource.data)
                && !('recordedAt' in resource.data)
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['recall', 'recordedAt'])
                && request.resource.data.recall is string
                && request.resource.data.recall.size() >= 20
                && request.resource.data.recall.size() <= 500
                && request.resource.data.recordedAt == request.time )
            );

          allow delete: if isMember() && request.auth.uid == memberId;
        }
      }

      // ---- 共同航海(単一ドキュメント voyage/current) ----
      // 目的地を決めると seed から海図(3航路)がひらき、選んだ航路を全員で進む。
      // 航路の中身(海域の位置)は seed からクライアントが決定的に導出するので
      // ここには置かない。進捗もカウンタを持たず、各メンバーの months から
      // 閲覧者が導出する。到着(arrivedAt)は在港者の誰かが1回だけ書ける。
      // 4人の友人港なので、作成・削除は在港者なら誰でも(簡素に)。
      match /voyage/{voyageId} {
        allow read: if isMember();

        // 作成: 在港者が、最小のキー集合で。seed・目標時間(分)・航路番号を検証する。
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['seed', 'targetMinutes', 'routeIndex', 'createdAt', 'createdBy'])
          && request.resource.data.seed is int
          && request.resource.data.seed >= 0
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes >= 60
          && request.resource.data.targetMinutes <= 600000
          && request.resource.data.routeIndex is int
          && request.resource.data.routeIndex >= 0
          && request.resource.data.routeIndex <= 2
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;

        // 更新: arrivedAt を一度だけ足せる(到着の刻印)。他フィールドは不変。
        allow update: if isMember()
          && !('arrivedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrivedAt'])
          && request.resource.data.arrivedAt is timestamp;

        // 削除: 在港者なら誰でも(到着後に「次の航海」で仕舞うため)。
        allow delete: if isMember();
      }

      // ---- 旧「港の試練」(quest/current) ----
      // 共同航海に置き換え済み。デプロイ済みの旧クライアントが読めるよう
      // しばらく残置する(新規の書き込みはもう発生しない)。
      match /quest/{questId} {
        allow read: if isMember();

        // 作成: 在港者が、最小のキー集合で。kind と目標時間(分)を検証する。
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['kind', 'targetMinutes', 'createdAt', 'createdBy'])
          && request.resource.data.kind in ['kraken', 'storm']
          && request.resource.data.targetMinutes is int
          && request.resource.data.targetMinutes >= 60
          && request.resource.data.targetMinutes <= 600000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;

        // 更新: defeatedAt を一度だけ足せる(討伐の刻印)。他フィールドは不変。
        allow update: if isMember()
          && !('defeatedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defeatedAt'])
          && request.resource.data.defeatedAt is timestamp;

        // 削除: 在港者なら誰でも(討伐後に「新たな試練」で流すため)。
        allow delete: if isMember();
      }

      // ---- チャット(言葉 + 着岸/帰還の自動の行) ----
      match /chat/{messageId} {
        allow read: if isMember();

        // 発言・自動の行とも、在港者本人だけが自分の uid で書ける。
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.kind in ['text', 'landfall', 'return']
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() == 0
          && (
            ( request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'createdAt', 'reactions'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 500
              && !request.resource.data.text.matches(
                '(?i).*(kill[ ._-]*yourself|\\bkys\\b|nigger|faggot|死ね|しね|殺す|ころす|自殺しろ).*'
              ) )
            ||
            ( request.resource.data.kind in ['landfall', 'return']
              && request.resource.data.keys().hasOnly(['uid', 'kind', 'itemName', 'itemStyle', 'itemSymbol', 'minutes', 'gapDays', 'createdAt', 'reactions'])
              && request.resource.data.itemName is string
              && request.resource.data.itemName.size() <= 60
              && request.resource.data.itemStyle is string
              && request.resource.data.itemStyle.size() <= 24
              && request.resource.data.itemSymbol is string
              && request.resource.data.itemSymbol.size() <= 24
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 1
              && request.resource.data.minutes <= 6000
              && ( !('gapDays' in request.resource.data)
                || (request.resource.data.gapDays is int
                  && request.resource.data.gapDays >= 0
                  && request.resource.data.gapDays <= 36500) ) )
          )
          && request.resource.data.createdAt == request.time;

        // 更新はリアクションのみ。自分の枠(reactions[自分のuid])だけを、許可された印で。
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
          && ( !(request.auth.uid in request.resource.data.reactions)
            || request.resource.data.reactions[request.auth.uid] in ['heart', 'lighthouse'] );

        // 自分の発言だけ、書いてから1時間以内に限り取り下げられる。
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.uid
          && request.time < resource.data.createdAt + duration.value(1, 'h');
      }
    }

    // ---- パブリックの港(公式5港) ----
    // 参加すると、名前・アイコン・作業記録がその港に表示される。
    // 不変条件: 書けるのも消せるのも「書いた本人だけ」。読みはサインイン済みなら誰でも。
    match /publicHarbors/{slug} {
      function validSlug() {
        return slug in ['language', 'certification', 'student', 'reading', 'making'];
      }

      // メンバーのプレイヤーカード。
      match /members/{memberId} {
        allow read: if request.auth != null;

        // boat* は船の見た目(部位id)。任意フィールドなので旧クライアントの書き込みも通る。
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && validSlug()
          && request.resource.data.keys().hasOnly(['displayName', 'styleToken', 'symbolToken', 'resolve', 'sinceDay', 'joinedAt', 'boatSail', 'boatJib', 'boatHull', 'boatStripe', 'boatFlag'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.styleToken is string
          && request.resource.data.styleToken.size() <= 24
          && request.resource.data.styleToken in ['midnight', 'coral', 'ink', 'seaGreen', 'violet', 'sunYellow', 'harbor', 'sand', 'ember', 'rust', 'lavender', 'sunrise']
          && request.resource.data.symbolToken is string
          && request.resource.data.symbolToken.size() <= 24
          && request.resource.data.symbolToken in ['anchor', 'compass', 'wheel', 'lighthouse', 'island', 'phoenix', 'book', 'pen', 'sailboat', 'attire', 'wave', 'comet', 'sun']
          && request.resource.data.resolve is string
          && request.resource.data.resolve.size() <= 80
          && ( !('boatSail' in request.resource.data)
            || (request.resource.data.boatSail is string && request.resource.data.boatSail.size() <= 24) )
          && ( !('boatJib' in request.resource.data)
            || (request.resource.data.boatJib is string && request.resource.data.boatJib.size() <= 24) )
          && ( !('boatHull' in request.resource.data)
            || (request.resource.data.boatHull is string && request.resource.data.boatHull.size() <= 24) )
          && ( !('boatStripe' in request.resource.data)
            || (request.resource.data.boatStripe is string && request.resource.data.boatStripe.size() <= 24) )
          && ( !('boatFlag' in request.resource.data)
            || (request.resource.data.boatFlag is string && request.resource.data.boatFlag.size() <= 24) )
          // 航海のはじまり(yyyy-MM-dd)。任意フィールド。書式を固定して、
          // ここが自由文の置き場にならないようにする。
          && ( !('sinceDay' in request.resource.data)
            || (request.resource.data.sinceDay is string
              && request.resource.data.sinceDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) );

        // 退港・削除は本人のみ。
        allow delete: if request.auth != null && request.auth.uid == memberId;

        // 月ごとの共有記録。積み上がって残り、消せるのは本人だけ。
        match /months/{monthId} {
          allow read: if request.auth != null;

          allow create, update: if request.auth != null
            && request.auth.uid == memberId
            && validSlug()
            && request.resource.data.keys().hasOnly(['days', 'sessions', 'updatedAt'])
            && request.resource.data.days is list
            && request.resource.data.days.size() <= 31
            && request.resource.data.sessions is list
            && request.resource.data.sessions.size() <= 1000;

          allow delete: if request.auth != null && request.auth.uid == memberId;
        }
      }
    }

    // ---- 公開誌(一日一頁) ----
    // 作成・更新・削除はApp Check付きCallableだけがAdmin SDKで行う。
    // 日付、1日1件、所属港、画像サイズをクライアントの直接書込みに委ねない。
    match /publicJournalEntries/{entryId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.query.limit != null
        && request.query.limit <= 30;
      allow create, update, delete: if false;
    }

    // 通報内容とレート制限は運営専用。クライアントからは存在確認もさせない。
    match /publicContentReports/{reportId} {
      allow read, write: if false;
    }
    match /publicContentReportLimits/{limitId} {
      allow read, write: if false;
    }

    // ---- 通報(書き捨て。読めるのは運営=コンソールのみ) ----
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'source', 'privateIslandCode', 'reporterUid', 'targetUid',
          'messageId', 'text', 'createdAt'
        ])
        && request.resource.data.source == 'privateIsland'
        && request.resource.data.reporterUid is string
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.privateIslandCode is string
        && request.resource.data.privateIslandCode.matches(
          '^[A-HJ-NP-Z2-9]{6}$'
        )
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() >= 1
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetUid != request.auth.uid
        && exists(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)
        ).data.memberIds
        && request.resource.data.targetUid in get(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)
        ).data.memberIds
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() >= 1
        && request.resource.data.messageId.size() <= 128
        && exists(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)/chat/$(request.resource.data.messageId)
        )
        && get(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)/chat/$(request.resource.data.messageId)
        ).data.uid == request.resource.data.targetUid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.text == get(
          /databases/$(database)/documents/privateIslands/$(request.resource.data.privateIslandCode)/chat/$(request.resource.data.messageId)
        ).data.text
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
