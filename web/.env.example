# .env.local にコピーして値を埋める(Firebase コンソール → プロジェクトの設定 → ウェブアプリ)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_APP_ID=

# App Check(reCAPTCHA Enterprise のサイトキー)。
# 本番ビルドでこれが無いと App Check トークンが付かず、
# enforceAppCheck 付きの Callable(課金導線など)が全て弾かれる。
# Cloudflare Pages のビルド環境変数にも同じ名前で設定すること。
VITE_FB_APP_CHECK_SITE_KEY=
