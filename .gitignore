# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Local agent/editor state
.claude/

# Blender automatic backup files
*.blend1

# Local deployment-tool cache (contains Cloudflare account metadata)
.wrangler/

# Firebase client config (obtain from Firebase console; required to build)
GoogleService-Info.plist

# Epic Online Services iOS SDK is fetched from Epic for local/device builds.
# Do not redistribute the SDK binary through source control.
Vendor/EOSSDK.xcframework/

# Python bytecode from the Blender/audio build scripts
__pycache__/

# Uncompressed renders from Tools/Audio scripts. The scripts are the source of
# truth; the shipped tracks are the compressed files under web/public/audio.
Tools/Audio/*.wav
/*.wav

# The official site is its own git repository, checked out here for convenience.
official-site/
